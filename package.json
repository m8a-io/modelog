{
  "name": "modelog",
  "displayName": "Modelog — AI Model Cost & Usage Analytics",
  "description": "See exactly what switching AI models costs and changes — measured from your own Claude Code & GitHub Copilot session logs. 100% local, zero telemetry.",
  "author": "Scott Molinari <scott.molinari@m8a.io>",
  "homepage": "https://modelog.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/m8a-io/modelog.git"
  },
  "bugs": {
    "url": "https://github.com/m8a-io/modelog/issues"
  },
  "version": "0.1.0",
  "publisher": "Modelog",
  "license": "MIT",
  "icon": "images/modelog-logo-128x128.png",
  "preview": true,
  "galleryBanner": {
    "color": "#1A1A2E",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=24"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "ai",
    "artificial intelligence",
    "llm",
    "large language model",
    "claude",
    "claude code",
    "anthropic",
    "copilot",
    "github copilot",
    "ai coding assistant",
    "ai agent",
    "pair programming",
    "cost tracking",
    "cost analysis",
    "spend tracking",
    "budget",
    "token usage",
    "token cost",
    "usage analytics",
    "dashboard",
    "metrics",
    "analytics",
    "model comparison",
    "api cost",
    "billing",
    "credits",
    "cache hit rate",
    "privacy",
    "session logs",
    "local-first"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "modelog.mcp",
        "label": "Modelog"
      }
    ],
    "commands": [
      {
        "command": "modelog.openDashboard",
        "title": "Modelog: Open Dashboard"
      },
      {
        "command": "modelog.rescan",
        "title": "Modelog: Rescan Session Logs"
      },
      {
        "command": "modelog.exportData",
        "title": "Modelog: Export Data"
      },
      {
        "command": "modelog.enableMcpServer",
        "title": "Modelog: Enable MCP Server (Claude Code)"
      },
      {
        "command": "modelog.disableMcpServer",
        "title": "Modelog: Disable MCP Server (Claude Code)"
      },
      {
        "command": "modelog.copyMcpConfiguration",
        "title": "Modelog: Copy MCP Server Configuration"
      },
      {
        "command": "modelog.mcpServerStatus",
        "title": "Modelog: MCP Server Status"
      },
      {
        "command": "modelog.enableCopilotAnalysis",
        "title": "Modelog: Enable Copilot Analysis"
      },
      {
        "command": "modelog.disableCopilotAnalysis",
        "title": "Modelog: Disable Copilot Analysis"
      },
      {
        "command": "modelog.copilotStatus",
        "title": "Modelog: Copilot Status"
      }
    ],
    "configuration": {
      "title": "Modelog",
      "properties": {
        "modelog.logPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "~/.claude/projects"
          ],
          "description": "Directories to scan for AI assistant session logs."
        },
        "modelog.billingMode": {
          "type": "string",
          "enum": [
            "auto",
            "subscription",
            "api"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Detect from Claude Code's configuration (recommended).",
            "Seat or plan billing — costs are shown as estimates at API list rates.",
            "Per-token API billing — costs track actual spend."
          ],
          "description": "How your AI assistant usage is billed. Determines how Modelog describes its cost figures."
        },
        "modelog.copilot.enabled": {
          "type": "string",
          "enum": [
            "auto",
            "off"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Read Copilot's debug logs if they already exist.",
            "Never read Copilot data, even if logs are present."
          ],
          "description": "Whether to include GitHub Copilot sessions. Modelog only ever reads logs Copilot has already written — it never turns Copilot's logging on by itself. Use \"Modelog: Enable Copilot Analysis\" for that."
        },
        "modelog.copilotLogPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Override the directories scanned for Copilot logs (both workspaceStorage and globalStorage — Copilot writes to whichever applies). Empty means derive both from this extension's own storage path, which is correct unless you run more than one VS Code installation."
        },
        "modelog.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the Modelog summary in the status bar."
        },
        "modelog.defaultRange": {
          "type": "string",
          "enum": [
            "7d",
            "30d",
            "90d",
            "all"
          ],
          "default": "30d",
          "description": "Default date range for the dashboard."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint:theme": "./scripts/check-theme.sh",
    "check": "npm run typecheck && npm run lint:theme && npm test",
    "pretest": "node scripts/check-node.mjs && node esbuild.mjs",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/*.test.ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "echarts": "^6.1.0"
  }
}
